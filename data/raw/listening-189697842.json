spera:tokenOrder=\"ascendingByIdentifier\" inspera:tokenPosition=\"right\" inspera:tokenSize=\"individualSize\" inspera:type=\"plainText\" responseIdentifier=\"RESPONSE\">\n    <prompt/>\n    \n    \n        \n            <gapText identifier=\"A\" matchMax=\"0\" matchMin=\"0\">fossils</gapText>\n        \n    \n        \n            <gapText identifier=\"B\" matchMax=\"0\" matchMin=\"0\">contamination</gapText>\n        \n    \n        \n            <gapText identifier=\"C\" matchMax=\"0\" matchMin=\"0\">vehicle</gapText>\n        \n    \n        \n            <gapText identifier=\"D\" matchMax=\"0\" matchMin=\"0\">powder</gapText>\n        \n    \n        \n            <gapText identifier=\"E\" matchMax=\"0\" matchMin=\"0\">heat</gapText>\n        \n    \n        \n            <gapText identifier=\"F\" matchMax=\"0\" matchMin=\"0\">results</gapText>\n        \n    \n        \n            <gapText identifier=\"G\" matchMax=\"0\" matchMin=\"0\">radiation</gapText>\n        \n    \n        \n            <gapText identifier=\"H\" matchMax=\"0\" matchMin=\"0\">site</gapText>\n        \n    \n        \n            <gapText identifier=\"I\" matchMax=\"0\" matchMin=\"0\">microbes</gapText>\n        \n    \n    \n        <blockquote>\n            <div class=\"table-widget-container\"><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" class=\"style-preset theme-border-4\" style=\"width: 500px;\"><tbody><tr><td><div class=\"style-preset box_black_border\">A spacecraft lands on a planet and sends out a rover.</div><div class=\"style-preset flow-chart-small-arrow\">⬇</div><div class=\"style-preset box_black_border\">The rover is directed to a <gap identifier=\"Gap1\"/> which has organic material.</div><div class=\"style-preset flow-chart-small-arrow\">⬇</div><div class=\"style-preset box_black_border\">It collects a sample from below the surface (in order to avoid the effects of <gap identifier=\"Gap2\"/> ).</div><div class=\"style-preset flow-chart-small-arrow\">⬇</div><div class=\"style-preset box_black_border\">The soil and rocks are checked to look for evidence of fossils.</div><div class=\"style-preset flow-chart-small-arrow\">⬇</div><div class=\"style-preset box_black_border\">The sample is converted to powder.</div><div class=\"style-preset flow-chart-small-arrow\">⬇</div><div class=\"style-preset box_black_border\">The sample is subjected to <gap identifier=\"Gap3\"/>.</div><div class=\"style-preset flow-chart-small-arrow\">⬇</div><div class=\"style-preset box_black_border\">A mass spectrometer is used to search for potential proof of life, e.g.  <gap identifier=\"Gap4\"/>.</div><div class=\"style-preset flow-chart-small-arrow\">⬇</div><div class=\"style-preset box_black_border\">The <gap identifier=\"Gap5\"/> are compared with existing data from Earth.</div></td></tr></tbody></table></div>\n        </blockquote>\n    \n</gapMatchInteraction>\n    </itemBody>","responseDeclarations":[{"identifier":"RESPONSE","cardinality":"multiple","baseType":"directedPair","defaultValue":[]}],"templateDeclarations":[{"identifier":"SCORE_EACH_CORRECT","cardinality":"single","baseType":"float","defaultValue":["1"]},{"identifier":"SCORE_EACH_WRONG","cardinality":"single","baseType":"float","defaultValue":["0"]},{"identifier":"SCORE_ALL_CORRECT","cardinality":"single","baseType":"float","defaultValue":[""]},{"identifier":"SCORE_MINIMUM","cardinality":"single","baseType":"float","defaultValue":[""]},{"identifier":"SCORE_UNANSWERED","cardinality":"single","baseType":"float","defaultValue":["0"]}],"version":"2.2","hasRubricsMarking":false,"customFields":[{"name":"Item Type","value":["Flow-chart Completion Objective"]},{"name":"Testing Focus level 1","value":["Listening"]}],"additionalResources":[],"mediaInfo":[],"maxScore":0.0,"presets":{},"questionNumberInQuestionSet":1,"sectionNumber":1,"questionNumberingInSection":"1","countingNumberingItem":true,"fixed":false,"orderNumber":2,"category":"","parentId":181951855}]}],"additionalResources":[{"type"