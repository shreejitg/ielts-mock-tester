{"contentRevisionId":189196783,"contentItemId":189196719,"assessmentRunContentId":189732243,"assessmentRunId":189732223,"title":"Sample - GTR - T/F/NG","supportedLanguages":["en_us"],"hasNestedSections":false,"hasBranchRules":false,"sections":[{"title":"IRGT1179EVOA","id":145445178,"mode":"NYI","layout":"vertical-left","allowStimulusResizing":true,"stimulusSize":50,"sectionQuestionOrdering":"none","numberOfQuestionsToPull":0,"parentId":189196719,"additionalResources":[],"customFields":[{"name":"Testing Focus level 1","value":["Reading"]},{"name":"Section","value":[1]}],"nonAdaptiveOrderNumber":1,"nonAdaptiveOrderNumberWithScorableQuestions":1,"sections":[],"questions":[{"contentItemId":145434169,"contentRevisionId":145435403,"title":"  Stimulus title","objectType":"content_question_qti2_content_block","supportedLanguages":["en-US"],"defaultLanguage":"en-US","itemBody":"<itemBody inspera:defaultLanguage=\"en-US\" inspera:supportedLanguages=\"en-US\">\n        <div class=\"question-main-illustration\">\n    \n    \n</div>\n<h1 class=\"style-preset reading-text-title\" style=\"\">Railway Season Tickets</h1><h2 class=\"style-preset reading-text-subtitle\" style=\"\">Types of Season Tickets</h2><p style=\"\">Standard season tickets allow unlimited travel between the two train stations shown on the ticket for the full duration of their validity. You can break your journey at any train station between the origin and destination station on your season ticket.</p><p style=\"\">Combined rail-and-bus season tickets are available from some rail stations. This means if you can make your main journey by rail, you can then complete it by bus. Two separate season tickets may be required for some destinations.</p><h2 class=\"style-preset reading-text-subtitle\" style=\"\">Ticket Duration</h2><p style=\"\"><strong>7-day</strong><br/>These normally cost less than five standard day-returns. They are valid for a full seven days’ rail travel between the points shown on the train ticket.</p><p style=\"\"><strong>Monthly</strong><br/>Monthly season tickets are priced at less than four times the cost of 7-day train tickets and are valid for a full calendar month from the date of commencement.</p><p style=\"\"><strong>Annual Card</strong><br/>This gives you a full calendar year's weekday travel for the price of only 40 weekly tickets. Annual Card holders can also save a third on the price of most Standard Class train fares in the region at weekends and on Bank Holidays. You can also take up to three adults with you at the same discount, while up to four children (aged 5–15) may accompany you for a minimum of £1 each.</p><p style=\"\"><strong>How do I buy my first season ticket?</strong><br/>Your season ticket is not valid without a photocard, and both must always be carried together. A photocard will be issued to you free of charge when you first purchase a season ticket. You just need to take a passport-sized photograph to a ticket office and we'll do the rest. As long as your photo remains a good likeness, you can continue to use the photocard with any subsequent season tickets that you buy.</p>\n    </itemBody>","responseDeclarations":[],"templateDeclarations":[],"version":"2.1","hasRubricsMarking":false,"customFields":[{"name":"Testing Focus level 1","value":["Reading"]}],"additionalResources":[],"mediaInfo":[],"presets":{},"sectionNumber":1,"questionNumberingInSection":"0","countingNumberingItem":false,"fixed":true,"orderNumber":2,"category":"stimulus","parentId":145445178},{"contentItemId":145434159,"contentRevisionId":145436122,"title":"  Identifying Information T/F/NG","objectType":"content_question_qti2_multiple_choice","supportedLanguages":["en_us"],"defaultLanguage":"en_us","itemBody":"<itemBody inspera:defaultLanguage=\"en_us\" inspera:supportedLanguages=\"en_us\">\n        <div class=\"question-main-illustration\">\n    \n    \n</div>\n<choiceInteraction maxChoices=\"1\" responseIdentifier=\"RESPONSE-3\" shuffle=\"false\">\n    <prompt>You are allowed to stop off at an intermediate station when making a journey using a standard season ticket.</prompt>\n    \n        <simpleChoice identifier=\"A\">TRUE</simpleChoice>\n    \n        <simpleChoice identifier=\"B\">FALSE</simpleChoice>\n    \n        <simpleChoice identifier=\"C\">NOT GIVEN</simpleChoice>\n    \n</choiceInteraction>\n<choiceInteraction maxChoices=\"1\" responseIdentifier=\"RESPONSE-4\" shuffle=\"false\">\n    <prompt>\nWhen using a combined rail-and-bus season ticket, the major part of your journey must be by train.</prompt>\n    \n        <simpleChoice identifier=\"A\">TRUE</simpleChoice>\n    \n        <simpleChoice identifier=\"B\">FALSE</simpleChoice>\n    \n        <simpleChoice identifier=\"C\">NOT GIVEN</simpleChoice>\n    \n</choiceInteraction>\n<choiceInteraction maxChoices=\"1\" responseIdentifier=\"RESPONSE-5\" shuffle=\"false\">\n    <prompt>\nIt is more expensive to buy four 7-day tickets than a monthly season ticket for the same journey.</prompt>\n    \n        <simpleChoice identifier=\"A\">TRUE</simpleChoice>\n    \n        <simpleChoice identifier=\"B\">FALSE</simpleChoice>\n    \n        <simpleChoice identifier=\"C\">NOT GIVEN</simpleChoice>\n    \n</choiceInteraction>\n<choiceInteraction maxChoices=\"1\" responseIdentifier=\"RESPONSE-6\" shuffle=\"false\">\n    <prompt>\nAnnual Card season tickets entitle you to savings on other rail journeys outside of the working week.</prompt>\n    \n        <simpleChoice identifier=\"A\">TRUE</simpleChoice>\n    \n        <simpleChoice identifier=\"B\">FALSE</simpleChoice>\n    \n        <simpleChoice identifier=\"C\">NOT GIVEN</simpleChoice>\n    \n</choiceInteraction>\n<choiceInteraction maxChoices=\"1\" responseIdentifier=\"RESPONSE-7\" shuffle=\"false\">\n    <prompt>Children under the age of five are charged one third of the full ticket price when accompanying you on an Annual Card journey.</prompt>\n    \n        <simpleChoice identifier=\"A\">TRUE</simpleChoice>\n    \n        <simpleChoice identifier=\"B\">FALSE</simpleChoice>\n    \n        <simpleChoice identifier=\"C\">NOT GIVEN</simpleChoice>\n    \n</choiceInteraction>\n<choiceInteraction maxChoices=\"1\" responseIdentifier=\"RESPONSE-8\" shuffle=\"false\">\n    <prompt>The photo you supply at the time of application is displayed on your season ticket.</prompt>\n    \n        <simpleChoice identifier=\"A\">TRUE</simpleChoice>\n    \n        <simpleChoice identifier=\"B\">FALSE</simpleChoice>\n    \n        <simpleChoice identifier=\"C\">NOT GIVEN</simpleChoice>\n    \n</choiceInteraction>\n<p style=\"\"> </p>\n    </itemBody>","responseDeclarations":[{"identifier":"RESPONSE-3","cardinality":"single","baseType":"identifier","defaultValue":[]},{"identifier":"RESPONSE-4","cardinality":"single","baseType":"identifier","defaultValue":[]},{"identifier":"RESPONSE-5","cardinality":"single","baseType":"identifier","defaultValue":[]},{"identifier":"RESPONSE-6","cardinality":"single","baseType":"identifier","defaultValue":[]},{"identifier":"RESPONSE-7","cardinality":"single","baseType":"identifier","defaultValue":[]},{"identifier":"RESPONSE-8","cardinality":"single","baseType":"identifier","defaultValue":[]}],"templateDeclarations":[{"identifier":"SCORE_EACH_CORRECT","cardinality":"single","baseType":"float","defaultValue":["1"]},{"identifier":"SCORE_EACH_WRONG","cardinality":"single","baseType":"float","defaultValue":["0"]},{"identifier":"SCORE_ALL_CORRECT","cardinality":"single","baseType":"float","defaultValue":[""]},{"identifier":"SCORE_MINIMUM","cardinality":"single","baseType":"float","defaultValue":[""]},{"identifier":"SCORE_UNANSWERED","cardinality":"single","baseType":"float","defaultValue":["0"]}],"version":"2.2","hasRubricsMarking":false,"customFields":[{"name":"Item Type","value":["T-F-NG"]},{"name":"Testing Focus level 1","value":["Reading"]}],"additionalResources":[],"mediaInfo":[],"maxScore":6.0,"presets":{},"questionNumberInQuestionSet":1,"sectionNumber":1,"questionNumberingInSection":"1","countingNumberingItem":true,"fixed":false,"orderNumber":3,"category":"","parentId":145445178}]}],"additionalResources":[],"questionNumbering":{"scorableItems":[{"orderNumber":1,"responseIdentifier":"RESPONSE-3","contentRevisionId":145436122},{"orderNumber":2,"responseIdentifier":"RESPONSE-4","contentRevisionId":145436122},{"orderNumber":3,"responseIdentifier":"RESPONSE-5","contentRevisionId":145436122},{"orderNumber":4,"responseIdentifier":"RESPONSE-6","contentRevisionId":145436122},{"orderNumber":5,"responseIdentifier":"RESPONSE-7","contentRevisionId":145436122},{"orderNumber":6,"responseIdentifier":"RESPONSE-8","contentRevisionId":145436122}]}}