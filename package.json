    "@types/react-dom": "^19.0.0",
    "cheerio": "^1.0.0",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
